@page
@model DACSWEBSK.Areas.Identity.Pages.Account.ConfirmCodeModel
@{
    ViewData["Title"] = "Xác nhận email";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">Xác nhận email</h2>
    <form method="post">
        <input type="hidden" asp-for="Input.Email" />
        <div class="mb-3">
            <label class="form-label">Nhập mã xác nhận đã gửi đến email của bạn:</label>
            <input asp-for="Input.Code" class="form-control" autocomplete="off" required />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Xác nhận</button>
        @if (Model.Message != null)
        {
            <div class="alert alert-info mt-3">@Model.Message</div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
