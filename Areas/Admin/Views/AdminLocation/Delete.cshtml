@model DACSWEBSK.Models.Location
@{
    ViewData["Title"] = "Xóa địa điểm";
}

<div class="container mt-5">
    <div class="card shadow-lg p-5 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <h2 class="text-center mb-5" style="color: #c0392b;">🗑️ Bạn có chắc chắn muốn xóa địa điểm này?</h2>
        <p class="text-center fs-5">📍 <strong>@Model.Name</strong></p>

        <form asp-action="Delete" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">🗑️ Xóa</button>
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 py-2">❌ Hủy</a>
            </div>
        </form>
    </div>
</div>
