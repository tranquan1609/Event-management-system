@model DACSWEBSK.Models.Location
@{
    ViewData["Title"] = "Chỉnh sửa địa điểm";
}

<div class="container mt-5">
    <div class="card shadow-lg p-5 rounded-4" style="background: linear-gradient(to right, #f1fdfd, #ffffff);">
        <h2 class="text-center mb-5" style="color: #0077b6;">✏️ @ViewData["Title"]</h2>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold">🏷️ Tên địa điểm</label>
                <input asp-for="Name" class="form-control rounded-pill shadow-sm" placeholder="Nhập tên địa điểm..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Address" class="form-label fw-bold">📍 Địa chỉ</label>
                <input asp-for="Address" class="form-control rounded-pill shadow-sm" placeholder="Nhập địa chỉ..." />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold">📄 Mô tả</label>
                <textarea asp-for="Description" class="form-control rounded-4 shadow-sm" rows="3" placeholder="Mô tả chi tiết địa điểm..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-center gap-4 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">🔙 Quay lại</a>
                <button type="submit" class="btn btn-success rounded-pill px-4 py-2">💾 Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
