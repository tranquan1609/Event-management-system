@model IEnumerable<DACSWEBSK.Models.OfflineAttendanceEvidence>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý minh chứng tham gia offline";
}

<style>
    .evidence-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 20px;
        margin-bottom: 2rem;
    }

    .evidence-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
        padding: 2rem;
    }

    .evidence-table {
        border-radius: 15px;
        overflow: hidden;
        border: 1px solid rgba(31, 38, 135, 0.1);
    }

    .evidence-table thead {
        background: linear-gradient(135deg, #f6f9fc 0%, #f1f4f9 100%);
    }

    .evidence-table th {
        font-weight: 600;
        color: #2d3748;
        padding: 1rem;
        border: none;
    }

    .evidence-table td {
        padding: 1rem;
        vertical-align: middle;
        border-color: rgba(31, 38, 135, 0.1);
    }

    .evidence-table tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
    }

    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 500;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        transition: all 0.3s ease;
        border: none;
        margin: 0 2px;
    }

    .btn-action:hover {
        transform: translateY(-2px);
    }

    .btn-info {
        background: linear-gradient(135deg, #0072ff 0%, #00c6ff 100%);
        color: white;
    }

    .btn-success {
        background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
        color: white;
    }

    .btn-danger {
        background: linear-gradient(135deg, #f85032 0%, #e73827 100%);
        color: white;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .status-pending {
        background-color: #ffc107;
        color: #000;
    }

    .status-approved {
        background-color: #28a745;
        color: white;
    }

    .status-rejected {
        background-color: #dc3545;
        color: white;
    }
</style>

<div class="evidence-header">
    <div class="container">
        <h1 class="display-6 mb-0">
            <i class="fas fa-file-upload me-2"></i>
            Quản lý minh chứng tham gia offline
        </h1>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="evidence-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0">Danh sách minh chứng</h4>
                <small class="text-muted">Lọc theo:</small>
                <form method="get" class="d-inline-block ms-2">
                    <select name="eventId" class="form-select form-select-sm d-inline-block" style="width: auto;" onchange="this.form.submit()">
                        <option value="">Tất cả sự kiện</option>
                        @foreach (var evt in ViewBag.Events as List<DACSWEBSK.Models.Event>)
                        {
                            <option value="@evt.Id" selected="@(ViewBag.CurrentEventId != null && ViewBag.CurrentEventId == evt.Id)">@evt.Title</option>
                        }
                    </select>
                    <select name="status" class="form-select form-select-sm d-inline-block ms-2" style="width: auto;" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewBag.CurrentStatus == "All")">Tất cả trạng thái</option>
                        <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Đang chờ duyệt</option>
                        <option value="Approved" selected="@(ViewBag.CurrentStatus == "Approved")">Đã duyệt</option>
                        <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">Đã từ chối</option>
                    </select>
                </form>
            </div>
            <a asp-action="ExportReport" asp-route-eventId="@ViewBag.CurrentEventId" asp-route-status="@ViewBag.CurrentStatus" class="btn btn-primary">
                <i class="fas fa-download me-2"></i>Xuất báo cáo
            </a>
        </div>

        <div class="table-responsive">
            <table class="table evidence-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sự kiện</th>
                        <th>Người tham gia</th>
                        <th>File</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Ngày upload</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <strong>@item.Event?.Title</strong>
                                </td>
                                <td>
                                    <div>@item.Attendee?.FullName</div>
                                    <small class="text-muted">@item.Attendee?.Email</small>
                                </td>
                                <td>
                                    <div>
                                        <i class="fas fa-file me-2"></i>@item.FileName
                                    </div>
                                    <small class="text-muted">@((item.FileSize / 1024.0 / 1024.0).ToString("F2")) MB</small>
                                </td>
                                <td class="text-center">
                                    <span class="status-badge status-@item.Status.ToLower()">
                                        @if (item.Status == "Pending")
                                        {
                                            <text><i class="fas fa-clock me-1"></i>Đang chờ</text>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <text><i class="fas fa-check-circle me-1"></i>Đã duyệt</text>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <text><i class="fas fa-times-circle me-1"></i>Đã từ chối</text>
                                        }
                                    </span>
                                </td>
                                <td class="text-center">
                                    <small>@item.UploadedAt.ToString("g")</small>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-info" title="Chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="DownloadFile" asp-route-id="@item.Id" class="btn-action btn-success" title="Tải xuống">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                Chưa có minh chứng nào
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

