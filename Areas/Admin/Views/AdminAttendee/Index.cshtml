@model IEnumerable<DACSWEBSK.Models.Attendee>

@{
    ViewData["Title"] = "Quản lý người tham gia";
    var events = ViewBag.Events as List<DACSWEBSK.Models.Event>;
    var currentEventId = ViewBag.CurrentEventId as int?;
}

<div class="container-fluid mt-4">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header Section with Gradient -->
        <div class="card-header border-0 py-4" style="background: linear-gradient(135deg, #0396FF, #0D47A1);">
            <div class="d-flex justify-content-between align-items-center px-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-people-fill text-white fs-2 me-3"></i>
                    <h2 class="m-0 text-white">@ViewData["Title"]</h2>
                </div>
                <div class="bg-white bg-opacity-25 px-3 py-2 rounded-pill">
                    <i class="bi bi-calendar-event text-white me-2"></i>
                    <span class="text-white">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="card-body p-4" style="background: linear-gradient(to bottom right, #f8f9fa, #ffffff);">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 border-start border-danger border-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                        <div>@TempData["Error"]</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Event Filter Section -->
            <div class="row mb-4">
                <div class="col-md-6 offset-md-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-white bg-opacity-75">
                        <div class="card-body">
                            <form method="get" class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold mb-3">
                                        <i class="bi bi-funnel-fill text-primary me-2"></i>
                                        Lọc theo sự kiện
                                    </label>
                                    <select name="eventId" onchange="this.form.submit()" 
                                            class="form-select form-select-lg rounded-pill border-0 shadow-sm">
                                        <option value="">-- Tất cả sự kiện --</option>
                                        @foreach (var evt in events)
                                        {
                                            <option value="@evt.Id" selected="@(currentEventId == evt.Id ? "selected" : null)">
                                                @evt.Title
                                            </option>
                                        }
                                    </select>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Attendees Table -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="text-center">
                                <th class="py-3 border-0">
                                    <i class="bi bi-person-circle text-primary me-2"></i>Họ tên
                                </th>
                                <th class="py-3 border-0">
                                    <i class="bi bi-envelope text-primary me-2"></i>Email
                                </th>
                                <th class="py-3 border-0">
                                    <i class="bi bi-telephone text-primary me-2"></i>Số điện thoại
                                </th>
                                <th class="py-3 border-0">
                                    <i class="bi bi-calendar-event text-primary me-2"></i>Sự kiện
                                </th>
                                <th class="py-3 border-0">
                                    <i class="bi bi-ticket-perforated text-primary me-2"></i>Trạng thái
                                </th>
                                <th class="py-3 border-0">
                                    <i class="bi bi-gear text-primary me-2"></i>Hành động
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var attendee in Model)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle bg-primary bg-opacity-10 text-primary me-3">
                                                    @attendee.FullName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>@attendee.FullName</div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <i class="bi bi-envelope-fill text-muted me-2"></i>
                                                @attendee.Email
                                            </div>
                                        </td>
                                        <td class="py-3 text-center">@attendee.Phone</td>
                                        <td class="py-3 text-center">
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">
                                                @attendee.Event?.Title
                                            </span>
                                        </td>
                                        <td class="py-3 text-center">
                                            @{
                                                var (badgeClass, badgeIcon) = attendee.TicketStatus switch
                                                {
                                                    "Pending" => ("bg-warning bg-opacity-10 text-warning", "bi-hourglass-split"),
                                                    "Confirmed" => ("bg-success bg-opacity-10 text-success", "bi-check-circle-fill"),
                                                    "Cancelled" => ("bg-danger bg-opacity-10 text-danger", "bi-x-circle-fill"),
                                                    _ => ("bg-secondary bg-opacity-10 text-secondary", "bi-question-circle-fill")
                                                };
                                            }
                                            <span class="badge @badgeClass rounded-pill px-3 py-2">
                                                <i class="bi @badgeIcon me-1"></i>
                                                @attendee.TicketStatus
                                            </span>
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (attendee.TicketStatus != "Confirmed")
                                            {
                                                <a asp-action="Edit" asp-route-id="@attendee.Id" 
                                                   class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                                    <i class="bi bi-pencil-fill me-1"></i>
                                                    Duyệt
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    Đã duyệt
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox-fill fs-1 d-block mb-3"></i>
                                            <p class="mb-0">Không có người tham gia nào.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.2rem;
    }

    .table > :not(caption) > * > * {
        background-color: transparent;
    }

    .table tbody tr:hover {
        background-color: rgba(3, 150, 255, 0.05);
    }
</style>
