@model IEnumerable<DACSWEBSK.Models.Notification>
@{
    ViewData["Title"] = "Danh sách thông báo";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-center flex-grow-1" style="color: #0077b6;">🎉 @ViewData["Title"]</h2>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2" style="background-color: #00b4d8; border-color: #00b4d8;">➕ Tạo mới</a>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>📝 Tiêu đề</th>
                    <th>📅 Ngày tạo</th>
                    <th>📌 Sự kiện liên kết</th>
                    <th class="text-end">⚙️ Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.CreatedAt.ToString("g")</td>
                            <td>
                                @if (item.Event != null)
                                {
                                    <span class="badge bg-info text-dark">@item.Event.Title</span>
                                }
                                else
                                {
                                    <span class="text-muted"><em>Không liên kết</em></span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1 rounded-pill">✏️</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1 rounded-pill">🔍</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger rounded-pill">🗑️</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Không có thông báo nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
