@model DACSWEBSK.Models.Notification
@{
    ViewData["Title"] = "Xóa thông báo";
}

<div class="container mt-5">
    <div class="card shadow-lg p-5 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <h2 class="text-center mb-5" style="color: #c0392b;">🗑️ Bạn có chắc chắn muốn xóa thông báo này?</h2>

        <dl class="row fs-5">
            <dt class="col-sm-3 fw-bold">📝 Tiêu đề:</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3 fw-bold">📄 Nội dung:</dt>
            <dd class="col-sm-9">@Model.Content</dd>

            <dt class="col-sm-3 fw-bold">📅 Ngày tạo:</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>

            <dt class="col-sm-3 fw-bold">📌 Sự kiện liên kết:</dt>
            <dd class="col-sm-9">@Model.Event?.Title ?? "<em>Không có</em>"</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-center gap-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">❌ Hủy</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2">🗑️ Xóa</button>
            </div>
        </form>
    </div>
</div>
