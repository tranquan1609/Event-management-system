@model DACSWEBSK.Models.Video
@{
    ViewData["Title"] = "Sửa video/livestream";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <h2 class="text-center mb-4" style="color: #0077b6;">✏️ @ViewData["Title"]</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label">📝 Tiêu đề</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Url" class="form-label">🔗 Link video/livestream (YouTube, Facebook...)</label>
                <input asp-for="Url" class="form-control" required placeholder="https://..." />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Duration" class="form-label">⏱️ Thời lượng (giây)</label>
                <input asp-for="Duration" class="form-control" type="number" min="1" required />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">📼 Loại</label>
                <select asp-for="Type" class="form-select" required>
                    <option value="0">Video</option>
                    <option value="1">Livestream</option>
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="IsRequired" class="form-check-input" type="checkbox" />
                    <label asp-for="IsRequired" class="form-check-label">🎯 Bắt buộc xem để nhận chứng nhận</label>
                </div>
                <span asp-validation-for="IsRequired" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success rounded-pill">💾 Lưu</button>
                <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary rounded-pill">🔙 Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
