@model IEnumerable<DACSWEBSK.Models.Gift>
@{
    ViewData["Title"] = "Quản lý phần quà";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-center mb-5" style="color: #0077b6;">🎉 @ViewData["Title"]</h2>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">➕ Thêm phần quà</a>
        </div>

        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>🎁 Tên phần quà</th>
                    <th>📄 Mô tả</th>
                    <th>🖼️ Ảnh</th>
                    <th>⭐ Điểm đổi</th>
                    <th>🔀 Ngẫu nhiên mã</th>
                    <th style="width: 150px;">⚙️ Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@FileStorage.GetAccessUrl(item.ImageUrl)" alt="Gift" class="img-thumbnail" style="max-width: 80px;" />
                            }
                            else
                            {
                                <span>❌ Không có</span>
                            }
                        </td>
                        <td>@item.RequiredPoints</td>
                        <td>@(item.IsRandomCode ? "✔️ Có" : "❌ Không")</td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
