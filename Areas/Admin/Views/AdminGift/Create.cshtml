@model DACSWEBSK.Models.Gift
@{
    ViewData["Title"] = "Tạo phần quà";
}

<div class="container mt-5">
    <div class="card shadow-lg p-5 rounded-4" style="background: linear-gradient(to right, #e0f7fa, #ffffff);">
        <h2 class="text-center mb-5" style="color: #0077b6;">🎁 @ViewData["Title"]</h2>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold">🏷️ Tên phần quà</label>
                <input asp-for="Name" class="form-control rounded-pill shadow-sm" placeholder="Nhập tên phần quà..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold">📄 Mô tả</label>
                <textarea asp-for="Description" class="form-control rounded-4 shadow-sm" rows="3" placeholder="Mô tả chi tiết phần quà..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label for="imageUpload" class="form-label fw-bold">⬆️ Tải hình ảnh từ máy</label>
                <input type="file" id="imageUpload" name="ImageFile" class="form-control rounded-pill shadow-sm" />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="RequiredPoints" class="form-label fw-bold">⭐ Điểm yêu cầu</label>
                <input asp-for="RequiredPoints" type="number" class="form-control rounded-pill shadow-sm" placeholder="Nhập điểm cần thiết..." />
                <span asp-validation-for="RequiredPoints" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsRandomCode" class="form-check-input" />
                <label asp-for="IsRandomCode" class="form-check-label fw-bold">🔀 Sử dụng mã ngẫu nhiên</label>
            </div>

            <div class="d-flex justify-content-center gap-4 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">🔙 Quay lại</a>
                <button type="submit" class="btn btn-success rounded-pill px-4 py-2">💾 Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
