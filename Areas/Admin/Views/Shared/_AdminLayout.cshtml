<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Admin Dashboard - @ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-sidebar {
            min-height: 100vh;
            background-color: #343a40;
            color: white;
        }

            .admin-sidebar a {
                color: white;
                text-decoration: none;
                display: block;
                padding: 10px 20px;
            }

                .admin-sidebar a:hover {
                    background-color: #495057;
                }

        .admin-header {
            background-color: #0d6efd;
            color: white;
            padding: 10px 20px;
        }

        main {
            flex: 1;
            padding: 20px;
        }
    </style>

</head>
<body>

    <div class="d-flex">
        <!-- Sidebar -->
        <div class="admin-sidebar p-3">
            <h4 class="text-center mb-4">Welcome Admin</h4>
            <a href="/Admin/AdminDashboard"><i class="bi bi-house-door"></i> Thống Kê</a>
            <a href="/Admin/AdminEvent"><i class="bi bi-calendar-event"></i> Quản Lý Sự Kiện</a>
            <a href="/Admin/AdminAttendee"><i class="bi bi-person-lines-fill"></i> Quản Lý Người Tham Gia</a>
            <a href="/Admin/AdminGift"><i class="bi bi-gift"></i> Quản Lý Quà Tặng</a>
            <a href="/Admin/AdminNotification"><i class="bi bi-bell"></i> Quản Lý Thông Báo</a>
            <a href="/Admin/AdminLocation"><i class="bi bi-geo-alt"></i> Quản Lý Địa Điểm</a>
            <a href="/Admin/AdminSchedule/SelectEvent"><i class="bi bi-calendar-check"></i> Quản Lý Lịch Trình</a>
            <a href="/Admin/AdminVideo"><i class="bi bi-camera-video"></i> Quản Lý Video</a>
            <a href="/Admin/AdminAssignment"><i class="bi bi-file-earmark-text"></i> Quản Lý Bài Thu Hoạch</a>
            <a href="/Admin/AdminEvidence"><i class="bi bi-file-earmark-check"></i> Quản Lý Minh Chứng</a>
            <a href="/"><i class="bi bi-arrow-left-circle"></i> Back to Website</a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 d-flex flex-column">
            <header class="admin-header">
                <h5>Welcome, Admin</h5>
            </header>

            <main class="container-fluid">
                @RenderBody()
            </main>

            <footer class="text-center py-3 bg-light">
                <small>© 2025 Admin Dashboard</small>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>