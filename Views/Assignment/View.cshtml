@model DACSWEBSK.Models.EventAssignment
@{
    ViewData["Title"] = "Bài thu hoạch";
}

<style>
    .assignment-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 3rem;
    }

    .assignment-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .info-card {
        background: #f8fafc;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .btn-submit {
        background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
        color: white;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-submit:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(78, 205, 196, 0.4);
        color: white;
    }
</style>

<div class="assignment-header">
    <div class="container">
        <h1 class="display-4 mb-4">@Model.Title</h1>
        <p class="lead mb-0">Sự kiện: @Model.Event?.Title</p>
    </div>
</div>

<div class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="assignment-container">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="info-card">
                <h5><i class="fas fa-align-left me-2"></i>Mô tả</h5>
                <p class="mb-0">@Html.Raw(Model.Description.Replace("\n", "<br />"))</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Instructions))
        {
            <div class="info-card">
                <h5><i class="fas fa-info-circle me-2"></i>Hướng dẫn làm bài</h5>
                <p class="mb-0">@Html.Raw(Model.Instructions.Replace("\n", "<br />"))</p>
            </div>
        }

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h5><i class="fas fa-calendar-times me-2"></i>Hạn nộp</h5>
                    <p class="mb-0">
                        @if (Model.DueDate.HasValue)
                        {
                            <span class="@(Model.DueDate.Value < DateTime.Now ? "text-danger fw-bold" : "")">
                                @Model.DueDate.Value.ToString("g")
                            </span>
                            @if (Model.DueDate.Value < DateTime.Now)
                            {
                                <br /><small class="text-danger">Đã quá hạn nộp!</small>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Không giới hạn thời gian</span>
                        }
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card">
                    <h5><i class="fas fa-star me-2"></i>Điểm tối đa</h5>
                    <p class="mb-0">@(Model.MaxScore?.ToString() ?? "Không giới hạn")</p>
                </div>
            </div>
        </div>

        <div class="info-card">
            <h5><i class="fas fa-cog me-2"></i>Hình thức nộp bài</h5>
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">
                        <i class="fas fa-file-upload me-2"></i>
                        Upload file: 
                        <span class="badge @(Model.AllowFileUpload ? "bg-success" : "bg-secondary")">
                            @(Model.AllowFileUpload ? "Cho phép" : "Không cho phép")
                        </span>
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="mb-0">
                        <i class="fas fa-keyboard me-2"></i>
                        Nhập văn bản: 
                        <span class="badge @(Model.AllowTextSubmission ? "bg-success" : "bg-secondary")">
                            @(Model.AllowTextSubmission ? "Cho phép" : "Không cho phép")
                        </span>
                    </p>
                </div>
            </div>
        </div>

        @if (ViewBag.ExistingSubmission != null)
        {
            var submission = ViewBag.ExistingSubmission as DACSWEBSK.Models.AssignmentSubmission;
            <div class="info-card border border-success">
                <h5 class="text-success">
                    <i class="fas fa-check-circle me-2"></i>Bài nộp của bạn
                </h5>
                <p class="mb-2">
                    <strong>Trạng thái:</strong> 
                    <span class="badge @(submission.Status == "Graded" ? "bg-success" : "bg-warning")">
                        @submission.Status
                    </span>
                </p>
                <p class="mb-2">
                    <strong>Ngày nộp:</strong> @submission.SubmittedAt.ToString("g")
                </p>
                @if (submission.Score.HasValue)
                {
                    <p class="mb-2">
                        <strong>Điểm số:</strong> 
                        <span class="badge bg-success fs-6">@submission.Score.Value / @(Model.MaxScore ?? 100)</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(submission.Feedback))
                {
                    <p class="mb-2">
                        <strong>Nhận xét:</strong>
                        <div class="mt-2 p-3 bg-light rounded">
                            @Html.Raw(submission.Feedback.Replace("\n", "<br />"))
                        </div>
                    </p>
                }
                @if (!string.IsNullOrEmpty(submission.FilePath))
                {
                    <p class="mb-2">
                        <strong>File đã nộp:</strong>
                        <a asp-action="DownloadFile" asp-route-id="@submission.Id" class="btn btn-sm btn-primary">
                            <i class="fas fa-download me-2"></i>@submission.FileName
                        </a>
                    </p>
                }
                @if (!string.IsNullOrEmpty(submission.TextContent))
                {
                    <p class="mb-2">
                        <strong>Nội dung văn bản:</strong>
                        <div class="mt-2 p-3 bg-light rounded">
                            @Html.Raw(submission.TextContent.Replace("\n", "<br />"))
                        </div>
                    </p>
                }
                <div class="mt-3">
                    <a asp-action="Submit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Nộp lại / Chỉnh sửa
                    </a>
                    <a asp-action="MySubmission" asp-route-id="@Model.Id" class="btn btn-info">
                        <i class="fas fa-eye me-2"></i>Xem chi tiết
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                @if (string.IsNullOrEmpty(ViewBag.UserEmail))
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Vui lòng đăng nhập để nộp bài!
                    </div>
                }
                else
                {
                    <a asp-action="Submit" asp-route-id="@Model.Id" class="btn-submit btn-lg">
                        <i class="fas fa-paper-plane me-2"></i>
                        Nộp bài ngay
                    </a>
                }
            </div>
        }
    </div>
</div>

