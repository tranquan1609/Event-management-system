@model DACSWEBSK.Models.Gift
@{
    ViewData["Title"] = "Đổi quà";
}

<div class="container mt-5">
    <h1 class="text-center text-primary mb-4">🎁 Xác nhận đổi quà</h1>

    <div class="card shadow-lg border-0 rounded-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@FileStorage.GetAccessUrl(Model.ImageUrl)" class="card-img-top rounded-top-4" alt="@Model.Name" style="height: 300px; object-fit: cover;">
        }
        <div class="card-body">
            <h4 class="card-title text-primary">@Model.Name</h4>
            <p class="text-muted">@Model.Description</p>
            <p>🔐 <strong>Điểm cần:</strong> <span class="badge bg-primary">@Model.RequiredPoints</span></p>

            <form asp-action="RedeemConfirmed" method="post" class="mt-3">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form-floating mb-3">
                    <input name="userEmail" class="form-control" placeholder="Email" required />
                    <label for="userEmail">Email của bạn</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill">✅ Xác nhận đổi quà</button>
                    <a asp-action="Index" class="btn btn-secondary rounded-pill">🔙 Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>
