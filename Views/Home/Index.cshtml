@{
    ViewData["Title"] = "Trang chủ";
    var events = ViewBag.Events as List<DACSWEBSK.Models.Event>;
    var ongoingEvents = ViewBag.OngoingEvents as List<DACSWEBSK.Models.Event>;
    var videos = ViewBag.Videos as List<DACSWEBSK.Models.Video>;
    var notifications = ViewBag.Notifications as List<DACSWEBSK.Models.Notification>;
    var isLoggedIn = User.Identity.IsAuthenticated;
    var userPoints = isLoggedIn ? ViewBag.UserPoints as int? : null;
    var gifts = isLoggedIn ? ViewBag.Gifts as List<DACSWEBSK.Models.Gift> : null;
}

<style>
    :root {
        --primary-color: #667eea;
        --secondary-color: #764ba2;
        --accent-color: #f093fb;
        --success-color: #4ecdc4;
        --warning-color: #f38ba8;
        --text-color: #2d3748;
        --light-bg: #f7fafc;
        --glass-bg: rgba(255, 255, 255, 0.25);
        --glass-border: rgba(255, 255, 255, 0.18);
        --event-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --accent-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --success-gradient: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
        --dark-gradient: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        background-attachment: fixed;
        font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-color);
        line-height: 1.6;
        overflow-x: hidden;
    }

        /* Floating particles background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.15) 0%, transparent 50%), radial-gradient(circle at 40% 40%, rgba(120, 219, 226, 0.15) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

    /* Enhanced Hero Section */
    .hero {
        position: relative;
        color: white;
        padding: 200px 20px;
        text-align: center;
        overflow: hidden;
        min-height: 500px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin-bottom: 5rem;
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.2)), radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, transparent 70%), url('../images/bg.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 30% 70%, rgba(102, 126, 234, 0.3) 0%, transparent 50%), radial-gradient(circle at 70% 30%, rgba(240, 147, 251, 0.2) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero h1 {
            font-size: 4rem;
            font-weight: 800;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            margin-bottom: 2rem;
            animation: heroFadeIn 1.2s ease-out;
            position: relative;
            z-index: 2;
            background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero p {
            font-size: 1.4rem !important;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
            margin-bottom: 3rem;
            animation: heroFadeIn 1.4s ease-out;
            max-width: 900px;
            position: relative;
            z-index: 2;
            opacity: 0.95;
            font-weight: 300;
            letter-spacing: 0.5px;
        }

        .hero .btn {
            padding: 18px 45px;
            font-size: 1.1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            animation: heroFadeIn 1.6s ease-out;
            background: var(--accent-gradient);
            border: none;
            color: white;
            border-radius: 50px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 25px rgba(240, 147, 251, 0.4);
            position: relative;
            z-index: 2;
            overflow: hidden;
        }

            .hero .btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: left 0.5s;
            }

            .hero .btn:hover {
                transform: translateY(-8px) scale(1.05);
                box-shadow: 0 15px 40px rgba(240, 147, 251, 0.6);
                color: white;
            }

                .hero .btn:hover::before {
                    left: 100%;
                }

    /* Modern Section Titles */
    .section-title {
        text-align: center;
        margin-bottom: 4rem;
        position: relative;
        padding-bottom: 20px;
        color: var(--text-color);
        animation: fadeInDown 1s ease-out;
        font-weight: 700;
        font-size: 2.5rem;
        background: var(--event-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 6px;
            background: var(--accent-gradient);
            border-radius: 3px;
            box-shadow: 0 4px 15px rgba(240, 147, 251, 0.4);
        }

        .section-title::before {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background: var(--success-gradient);
            border-radius: 2px;
        }

    /* Glassmorphism Cards */
    .card {
        border: none;
        border-radius: 25px;
        overflow: hidden;
        backdrop-filter: blur(20px);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: cardSlideUp 0.8s ease-out;
        animation-fill-mode: both;
        position: relative;
    }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 20px 60px rgba(31, 38, 135, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

            .card:hover::before {
                opacity: 1;
            }

    .card-img-top {
        height: 280px;
        object-fit: cover;
        transition: all 0.4s ease;
        filter: brightness(0.9) contrast(1.1);
    }

    .card:hover .card-img-top {
        transform: scale(1.08);
        filter: brightness(1) contrast(1.2);
    }

    .card-body {
        padding: 2.5rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
    }

    .card-title {
        color: var(--primary-color);
        font-weight: 700;
        margin-bottom: 1.5rem;
        font-size: 1.3rem;
    }

    /* Enhanced Event Info */
    .event-info {
        padding: 15px 0;
        border-bottom: 2px solid rgba(102, 126, 234, 0.1);
        margin-bottom: 15px;
    }

        .event-info i {
            width: 30px;
            text-align: center;
            margin-right: 15px;
            font-size: 1.1rem;
        }

        .event-info p {
            transition: all 0.3s ease;
            margin-bottom: 10px;
            font-weight: 500;
        }

            .event-info p:hover {
                transform: translateX(8px);
                color: var(--primary-color);
            }

    /* Modern Badges */
    .badge {
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.85rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

        .badge.bg-success {
            background: var(--success-gradient) !important;
        }

        .badge.bg-primary {
            background: var(--event-gradient) !important;
        }

        .badge.bg-info {
            background: var(--accent-gradient) !important;
        }

    /* Enhanced Carousel */
    .carousel {
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.1);
        position: relative;
    }

        .carousel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(102, 126, 234, 0.1), rgba(240, 147, 251, 0.1));
            pointer-events: none;
            z-index: 1;
        }

    .carousel-item img {
        height: 650px;
        object-fit: cover;
        filter: contrast(1.1) brightness(0.95);
        transition: all 0.5s ease;
    }

    .carousel-item.active img {
        filter: contrast(1.2) brightness(1);
    }

    .carousel-caption {
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(15px);
        padding: 30px;
        border-radius: 20px;
        max-width: 85%;
        margin: 0 auto;
        bottom: 50px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .carousel-caption h3 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 15px;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .carousel-caption p {
            font-size: 1.2rem;
            line-height: 1.8;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
            font-weight: 300;
            opacity: 0.95;
        }

    .carousel-indicators button {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        margin: 0 8px;
        background-color: rgba(255, 255, 255, 0.4);
        border: 3px solid rgba(255, 255, 255, 0.6);
        transition: all 0.4s ease;
        backdrop-filter: blur(5px);
    }

        .carousel-indicators button.active {
            background: var(--accent-gradient);
            border-color: white;
            transform: scale(1.3);
            box-shadow: 0 4px 15px rgba(240, 147, 251, 0.6);
        }

    /* Enhanced Buttons */
    .btn-primary, .btn-outline-primary {
        border-radius: 30px;
        padding: 12px 30px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: relative;
        overflow: hidden;
    }

    .btn-primary {
        background: var(--event-gradient);
        border: none;
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    }

    .btn-outline-primary {
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
    }

        .btn-primary:hover, .btn-outline-primary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 12px 35px rgba(102, 126, 234, 0.6);
            color: white;
        }

        .btn-outline-primary:hover {
            background: var(--event-gradient);
            border-color: transparent;
        }

    /* Enhanced Alerts */
    .alert {
        border: none;
        border-radius: 20px;
        padding: 25px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border-left: 6px solid var(--primary-color);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
    }

    .alert-info {
        color: var(--primary-color);
        border-left-color: var(--accent-color);
    }

    /* Modern Footer */
    footer {
        background: var(--dark-gradient);
        color: white;
        padding: 60px 0;
        margin-top: 6rem;
        position: relative;
        overflow: hidden;
    }

        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--accent-gradient);
        }

        footer a {
            color: #fff;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }

            footer a:hover {
                color: var(--accent-color);
                text-shadow: 0 0 10px rgba(240, 147, 251, 0.5);
            }

    /* Animations */
    @@keyframes heroFadeIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardSlideUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(50px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Staggered animations */
    .row > div:nth-child(1) .card {
        animation-delay: 0.1s;
    }

    .row > div:nth-child(2) .card {
        animation-delay: 0.2s;
    }

    .row > div:nth-child(3) .card {
        animation-delay: 0.3s;
    }

    .row > div:nth-child(4) .card {
        animation-delay: 0.4s;
    }

    .row > div:nth-child(odd) .card {
        animation: slideInLeft 0.8s ease-out both;
    }

    .row > div:nth-child(even) .card {
        animation: slideInRight 0.8s ease-out both;
    }

    /* Enhanced hover effects */
    .btn {
        position: relative;
        overflow: hidden;
    }

        .btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn:hover::after {
            width: 300px;
            height: 300px;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero {
            padding: 150px 20px;
        }

            .hero h1 {
                font-size: 2.8rem;
            }

            .hero p {
                font-size: 1.1rem !important;
            }

            .hero .btn {
                font-size: 1rem;
                padding: 15px 35px;
            }

        .section-title {
            font-size: 2rem;
        }

        .card-body {
            padding: 2rem;
        }

        .carousel-item img {
            height: 400px;
        }

        .carousel-caption {
            padding: 20px;
            bottom: 30px;
        }

            .carousel-caption h3 {
                font-size: 1.5rem;
            }

            .carousel-caption p {
                font-size: 1rem;
            }
    }

    @@media (max-width: 576px) {
        .hero h1 {
            font-size: 2.2rem;
        }

        .section-title {
            font-size: 1.8rem;
        }

        .card {
            border-radius: 20px;
        }

        .carousel {
            border-radius: 20px;
        }

        .carousel-caption {
            max-width: 95%;
        }
    }
</style>

<!-- Hero Section -->
<div class="hero">
    <div class="container text-center">
        <h1 class="mb-4">"Tri Thức - Đạo Đức - Sáng Tạo"</h1>
        <p class="lead mb-5 mx-auto" style="max-width: 800px;">
            Khám phá và tham gia các sự kiện hấp dẫn cùng chúng tôi
        </p>
        <a href="/Event/Index" class="btn">
            <i class="fas fa-calendar-plus"></i> Đăng ký tham gia sự kiện
        </a>
    </div>
</div>

<!-- Carousel -->
<div class="container my-5">
    <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#imageCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#imageCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#imageCarousel" data-bs-slide-to="2"></button>
            <button type="button" data-bs-target="#imageCarousel" data-bs-slide-to="3"></button>
            <button type="button" data-bs-target="#imageCarousel" data-bs-slide-to="4"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="/images/hoinghicntt.jpg" class="d-block w-100" alt="Hội nghị CNTT">
                <div class="carousel-caption">
                    <h3>Hội nghị CNTT</h3>
                    <p>Chia sẻ kiến thức và kinh nghiệm trong lĩnh vực công nghệ thông tin</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/hoithao.jpg" class="d-block w-100" alt="Hội thảo">
                <div class="carousel-caption">
                    <h3>Hội thảo Chuyên ngành</h3>
                    <p>Cập nhật xu hướng và công nghệ mới nhất</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/ngayhoivieclam.jpg" class="d-block w-100" alt="Ngày hội việc làm">
                <div class="carousel-caption">
                    <h3>Ngày hội Việc làm</h3>
                    <p>Kết nối sinh viên với nhà tuyển dụng hàng đầu</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/kyniem30nam.jpg" class="d-block w-100" alt="Kỷ niệm 30 năm">
                <div class="carousel-caption">
                    <h3>Kỷ niệm 30 năm</h3>
                    <p>Hành trình phát triển và những thành tựu đáng tự hào</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="/images/mangmaytinh.png" class="d-block w-100" alt="Mạng máy tính">
                <div class="carousel-caption">
                    <h3>Công nghệ Mạng</h3>
                    <p>Đào tạo chuyên sâu về hệ thống mạng và bảo mật</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>

<!-- Upcoming Events -->
<div class="container py-5">
    <h2 class="section-title">
        <i class="fas fa-calendar-alt me-2"></i>
        Sự kiện sắp diễn ra
    </h2>
    <div class="row g-4">
        @if (events == null || !events.Any())
        {
            <div class="col-12 text-center">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Hiện tại chưa có sự kiện nào được lên lịch.
                </div>
            </div>
        }
        else
        {
            @foreach (var eventItem in events)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="position-relative">
                            <img src="@eventItem.ImageUrl" class="card-img-top" alt="@eventItem.Title">
                            @if (eventItem.Status == "Upcoming")
                            {
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-success">
                                        <i class="fas fa-clock me-1"></i>
                                        Sắp diễn ra
                                    </span>
                                </div>
                            }
                            else if (eventItem.Status == "Ongoing")
                            {
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-primary">
                                        <i class="fas fa-play me-1"></i>
                                        Đang diễn ra
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Title</h5>
                            <div class="event-info">
                                <p class="mb-2">
                                    <i class="fas fa-calendar-alt text-primary"></i>
                                    <strong>Thời gian:</strong><br />
                                    <span class="ms-4">@eventItem.StartTime.ToString("dd/MM/yyyy HH:mm")</span>
                                </p>
                                <p class="mb-2">
                                    <i class="fas fa-map-marker-alt text-danger"></i>
                                    <strong>Địa điểm:</strong><br />
                                    <span class="ms-4">@(eventItem.Location?.Name ?? "Chưa cập nhật")</span>
                                </p>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem.Id"
                                   class="btn btn-outline-primary">
                                    <i class="fas fa-info-circle me-1"></i> Chi tiết
                                </a>
                                @if (eventItem.Status != "Completed")
                                {
                                    <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem.Id"
                                       class="btn btn-primary">
                                        <i class="fas fa-user-plus me-1"></i> Đăng ký
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Ongoing Events -->
<div class="container py-5">
    <h2 class="section-title">
        <i class="fas fa-play-circle me-2"></i>
        Sự kiện đang diễn ra
    </h2>
    <div class="row g-4">
        @if (ongoingEvents == null || !ongoingEvents.Any())
        {
            <div class="col-12 text-center">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Hiện tại không có sự kiện nào đang diễn ra.
                </div>
            </div>
        }
        else
        {
            @foreach (var eventItem in ongoingEvents)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="position-relative">
                            <img src="@eventItem.ImageUrl" class="card-img-top" alt="@eventItem.Title">
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-primary">
                                    <i class="fas fa-play me-1"></i>
                                    Đang diễn ra
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@eventItem.Title</h5>
                            <div class="event-info">
                                <p class="mb-2">
                                    <i class="fas fa-calendar-alt text-primary"></i>
                                    <strong>Thời gian:</strong><br />
                                    <span class="ms-4">@eventItem.StartTime.ToString("dd/MM/yyyy HH:mm") - @eventItem.EndTime.ToString("dd/MM/yyyy HH:mm")</span>
                                </p>
                                <p class="mb-2">
                                    <i class="fas fa-map-marker-alt text-danger"></i>
                                    <strong>Địa điểm:</strong><br />
                                    <span class="ms-4">@(eventItem.Location?.Name ?? "Chưa cập nhật")</span>
                                </p>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem.Id"
                                   class="btn btn-outline-primary">
                                    <i class="fas fa-info-circle me-1"></i> Chi tiết
                                </a>
                                <a asp-controller="Event" asp-action="Details" asp-route-id="@eventItem.Id"
                                   class="btn btn-primary">
                                    <i class="fas fa-video me-1"></i> Xem trực tiếp
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Featured Videos -->
<div class="container py-5">
    <h2 class="section-title">🎥 Video nổi bật</h2>
    <div class="row g-4">
        @if (videos == null || !videos.Any())
        {
            <p class="text-muted text-center">Chưa có video nào.</p>
        }
        else
        {
            @foreach (var video in videos.Take(2))
            {
                <div class="col-md-6">
                    <div class="card">
                        @{
                            var videoId = "";
                            var thumbnailUrl = "/images/default-video-thumbnail.jpg"; // Default thumbnail
                            
                            if (!string.IsNullOrEmpty(video.Url))
                            {
                                try
                                {
                                    // Extract video ID from different YouTube URL formats
                                    if (video.Url.Contains("youtu.be/"))
                                    {
                                        videoId = video.Url.Split("youtu.be/").Last().Split("?").First();
                                    }
                                    else if (video.Url.Contains("youtube.com/watch?v="))
                                    {
                                        videoId = video.Url.Split("v=").Last().Split("&").First();
                                    }
                                    else if (video.Url.Contains("youtube.com/embed/"))
                                    {
                                        videoId = video.Url.Split("embed/").Last().Split("?").First();
                                    }
                                    else
                                    {
                                        videoId = video.Url.Trim(); // Assume it's already an ID
                                    }

                                    if (!string.IsNullOrEmpty(videoId))
                                    {
                                        thumbnailUrl = $"https://img.youtube.com/vi/{videoId}/maxresdefault.jpg";
                                    }
                                }
                                catch
                                {
                                    // If any error occurs, use default thumbnail
                                    videoId = "";
                                }
                            }
                        }
                        <div class="video-thumbnail-container" style="position: relative; overflow: hidden;">
                            <img src="@thumbnailUrl" 
                                 onerror="this.onerror=null; this.src='https://img.youtube.com/vi/@videoId/0.jpg';"
                                 class="card-img-top" 
                                 alt="@video.Title"
                                 style="height: 280px; object-fit: cover;">
                            <div class="video-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; transition: all 0.3s ease;">
                                <div class="play-button" style="width: 60px; height: 60px; background: rgba(255,255,255,0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease;">
                                    <i class="fas fa-play" style="font-size: 24px; color: #764ba2; margin-left: 4px;"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@video.Title</h5>
                            <p><strong>Sự kiện:</strong> @(video.Event?.Title ?? "Chưa có sự kiện")</p>
                            @if (!string.IsNullOrEmpty(videoId))
                            {
                                <a href="https://youtube.com/watch?v=@videoId" target="_blank" class="btn btn-primary w-100">
                                    <i class="fas fa-play-circle me-2"></i>Xem video
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="fas fa-exclamation-circle me-2"></i>Video không khả dụng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Latest Notifications -->
<div class="container py-5">
    <h2 class="section-title">📣 Thông báo mới nhất</h2>
    <div class="row g-4">
        @if (notifications == null || !notifications.Any())
        {
            <p class="text-muted text-center">Không có thông báo nào.</p>
        }
        else
        {
            @foreach (var noti in notifications.Take(3))
            {
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@noti.Title</h5>
                            <p class="text-truncate">@noti.Content</p>
                            <div class="mb-2">
                                @if (noti.Event != null)
                                {
                                    <span class="badge bg-info text-dark">
                                        📌 Sự kiện: @noti.Event.Title
                                    </span>
                                }
                            </div>
                            <small class="text-muted">🗓️ @noti.CreatedAt.ToString("g")</small>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="text-center mt-4">
        <a href="/Notification/Index" class="btn btn-primary">Xem tất cả thông báo</a>
    </div>
</div>

